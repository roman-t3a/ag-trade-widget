{
  "name": "ag-trade-widget",
  "version": "3.5.1",
  "private": true,
  "description": "Tampermonkey userscript: GMGN/Axiom-style buy/sell widget that trades through Alpha Gardeners wallets",
  "scripts": {
    "lint": "eslint .",
    "check": "node --check ag-trade-widget.user.js && node scripts/check-userscript.js",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e/widget.e2e.js",
